{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Local workspace commands for the main window. No shell, device or filesystem plugin access.",
  "windows": ["main"],
  "permissions": [
    "allow-workspace-snapshot",
    "allow-replace-workspace-board",
    "allow-workspace-action",
    "allow-explorer-page",
    "allow-preview-candidate",
    "allow-preferences-snapshot",
    "allow-save-preferences",
    "allow-history-snapshot",
    "allow-device-request",
    "allow-calibration-request"
  ]
}
